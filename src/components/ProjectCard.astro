---
import { iconMap, projects } from "../data/projectsData";
import type { IProject } from "../data/projectsData";
import IconGithub from "../icons/github.astro";

interface Props {
	project: IProject;
	isEven: boolean;
}

const { project, isEven } = Astro.props;
const carouselId = `carousel-${Math.random().toString(36).slice(2, 8)}`;
---


<div
	class={`project-card relative z-0 bg-black/30 px-6 py-4 md:px-10 md:py-8 rounded-xl border-2 md:border-[3px] border-transparent
		flex flex-col gap-4 md:gap-6 ${isEven ? "items-end text-right" : "items-start text-left"}`}
>
	{/* Proyect info */}
	<div class={`flex flex-col gap-2 ${isEven ? "items-end" : "items-start"}`}>
		<h3
			class="text-base text-[#AEC6FF] md:text-xl lg:text-2xl font-semibold"
		>
			{project.title}
		</h3>
		<p
			class="text-[10px] md:text-[12px] lg:text-[14px] w-full md:w-9/10 font-medium text-[#c2c2c2]"
		>
			{project.description}
		</p>
	</div>
	{/* Proyect tools */}
	<div
		class={`flex flex-wrap gap-2 md:gap-4 ${isEven ? "justify-end" : "justify-start"}`}
	>
		{
			project.tools.map((t) => {
				const Icon = iconMap[t.name];
				return (
					<div class="flex items-center gap-1.5 bg-white/5 px-1.5 py-0.5 md:px-2.5 md:py-1.5 rounded-md border border-white/10">
						{Icon && (
							<div class="w-3 h-3 md:w-4 md:h-4 lg:w-5 lg:h-5">
								<Icon />
							</div>
						)}
						<span class="text-[9px] md:text-[11px] lg:text-[12px] font-medium text-[#c2c2c2]">
							{t.name}
						</span>
					</div>
				);
			})
		}
	</div>
	{/* Proyect image */}
	<div class="carousel-wrapper">
		<button class="carousel-btn carousel-btn--prev" data-carousel={carouselId} aria-label="Imagen anterior" disabled>
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
		</button>
		<picture
			class="h-144 w-full rounded-lg overflow-x-hidden overflow-y-hidden border border-white/5 flex"
			id={carouselId}
		>
			{project.images.map((i) =>
				<img src={i.ref} alt={i.title} class="w-full h-fit shrink-0" />
			)}
		</picture>
		<button class="carousel-btn carousel-btn--next" data-carousel={carouselId} aria-label="Siguiente imagen">
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
		</button>
	</div>

	{/* Github button */}
	<div class={`flex w-full ${isEven ? "justify-end" : "justify-start"}`}>
		<a href={project.github} target="_blank" class="github-button group">
			Ver en GitHub
			<div class="w-6 h-6">
				<IconGithub />
			</div>
		</a>
	</div>
</div>

<style>
	.github-button {
		height: 2.5rem;
		width: 10rem;
		border: 2px solid rgba(255, 255, 255, 0.2);
		border-radius: 0.6rem;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		font-size: 0.8rem;
		font-weight: 500;
		transition: all 0.3s;
		color: white;
		text-decoration: none;
		background-color: rgba(255, 255, 255, 0.1);
	}

	.github-button:hover {
		background-color: rgba(255, 255, 255, 0.2);
		border-color: white;
		box-shadow: 0 0 16px rgba(255, 255, 255, 0.4);
	}

	.github-button div {
		transition: transform 0.3s ease;
	}

	@media screen and (max-width: 768px) {
		.github-button {
			height: 2.2rem;
			width: 8.5rem;
			font-size: 0.7rem;
		}
	}

	/* Carousel */
	.carousel-wrapper {
		position: relative;
		width: 100%;
	}

	.carousel-btn {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		z-index: 10;
		background-color: rgba(0, 0, 0, 0.5);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 50%;
		width: 2.2rem;
		height: 2.2rem;
		display: flex;
		align-items: center;
		justify-content: center;
		color: white;
		cursor: pointer;
		transition: background-color 0.2s, opacity 0.2s;
		backdrop-filter: blur(4px);
	}

	.carousel-btn--prev { left: 0.5rem; }
	.carousel-btn--next { right: 0.5rem; }

	.carousel-btn:hover:not(:disabled) {
		background-color: rgba(255, 255, 255, 0.2);
	}

	.carousel-btn:disabled {
		opacity: 0.2;
		cursor: default;
	}
</style>

<script>
	document.querySelectorAll<HTMLButtonElement>('.carousel-btn').forEach((btn) => {
		btn.addEventListener('click', () => {
			const id = btn.dataset.carousel!;
			const track = document.getElementById(id) as HTMLElement;
			const scrollAmount = track.clientWidth;
			const direction = btn.classList.contains('carousel-btn--prev') ? -1 : 1;
			track.scrollBy({ left: direction * scrollAmount, behavior: 'smooth' });
		});
	});

	document.querySelectorAll<HTMLElement>('picture[id^="carousel-"]').forEach((track) => {
		const wrapper = track.closest('.carousel-wrapper')!;
		const prevBtn = wrapper.querySelector<HTMLButtonElement>('.carousel-btn--prev')!;
		const nextBtn = wrapper.querySelector<HTMLButtonElement>('.carousel-btn--next')!;

		const update = () => {
			const atStart = track.scrollLeft <= 1;
			const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
			prevBtn.disabled = atStart;
			nextBtn.disabled = atEnd;
		};

		// Hide next arrow if only one image
		if (track.scrollWidth <= track.clientWidth + 1) nextBtn.disabled = true;

		track.addEventListener('scroll', update, { passive: true });
		update();
	});
</script>
