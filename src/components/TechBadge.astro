---
import { iconMap } from "../data/projectsData";
import type { ITool } from "../data/projectsData";

interface Props {
	tech: ITool;
}

const { tech } = Astro.props;
const Icon = iconMap[tech.name];
---

<a
	href={tech.link}
	target="_blank"
	class="flex flex-col items-center gap-3 group transition-all duration-300"
>
	<div class="w-12 h-12 sm:w-14 sm:h-14 md:w-16 md:h-16 bg-white/5 rounded-xl border border-white/10 flex items-center justify-center group-hover:scale-110 group-hover:border-[#AEC6FF]/50 group-hover:bg-[#AEC6FF]/10 transition-all duration-300 shadow-lg group-hover:shadow-[#AEC6FF]/20">
		{Icon ? (
			<div class="w-7 h-7 sm:w-8 sm:h-8 md:w-10 md:h-10 text-white/70 group-hover:text-[#AEC6FF] transition-colors">
				<Icon />
			</div>
		) : (
			<span class="text-xs">
				{tech.name[0]}
			</span>
		)}
	</div>
	<span class="text-[10px] md:text-xs font-medium text-[#c2c2c2] group-hover:text-white transition-colors">
		{tech.name}
	</span>
</a>
