---
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/portfolio.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Pagina web de Matias Salinas para mostrar algunos de sus proyectos y fuertes en el desarrollo web.">
		<title>Portfolio</title>
		<ClientRouter />
	</head>
	<body>
		<main class="mainContent relative">
			<Navbar />
			<slot />
		</main>
	</body>
</html>

<style>
	html {
		height: 100%;
		background: rgb(22,13,99);
		font-family: "Montserrat";
	}

	body {
		width: 100%;
		height: 100%;
		color: white;
	}

	.mainContent {
		height: 100%;
		background: radial-gradient(
			circle at 33% 50%,
			rgb(1, 24, 51) 0%,
			rgb(0, 19, 41) 14%,
			rgb(0, 5, 12) 100%
		);
		overflow-y: auto;
	}
	
	@font-face {
		font-family: "Montserrat";
		src: url("/fonts/Montserrat-ExtraLight.ttf") format("truetype");
		font-weight: 300;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Montserrat";
		src: url("/fonts/Montserrat-Light.ttf") format("truetype");
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Montserrat";
		src: url("/fonts/Montserrat-Medium.ttf") format("truetype");
		font-weight: 500;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Montserrat";
		src: url("/fonts/Montserrat-SemiBold.ttf") format("truetype");
		font-weight: 600;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Montserrat";
		src: url("/fonts/Montserrat-Bold.ttf") format("truetype");
		font-weight: 700;
		font-style: normal;
		font-display: swap;
	}

	:global(*)::-webkit-scrollbar-track {
		background: transparent;
	}
	:global(*)::-webkit-scrollbar {
		width: 8px;
		background: transparent;
	}
	:global(*)::-webkit-scrollbar-thumb {
		background-color: rgba(255, 255, 255, 0.25);
		border-radius: 10px;
	}
</style>
