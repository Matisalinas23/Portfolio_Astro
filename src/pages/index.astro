---
import Layout from "../layouts/Layout.astro";
import GithubIcon from "../icons/github-contact.astro";
import LinkedinIcon from "../icons/linkedin.astro";
import DownloadIcon from "../icons/download.astro";
import { projects, iconMap } from "../data/projectsData";
import {
	frontTechnologies,
	backTechnologies,
	tools,
} from "../data/stackData";
import UtnIcon from "../icons/utn.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TechBadge from "../components/TechBadge.astro";
---

<Layout>
	<main class="flex flex-col items-center pt-6 pb-16">
		{/* Cntenedor guia */}
		<div class="w-11/12 md:w-4/5 max-w-7xl flex flex-col items-center">
			<section
				id="inicio"
				class="relative pt-28 w-full px-0 flex flex-col-reverse lg:flex-row justify-between items-center gap-10"
			>
				<div class="w-full lg:w-3/5 flex flex-col gap-8">
					<div class="flex flex-col items-center lg:items-start mb-8">
						<h1 class="text-xl font-semibold sm:text-3xl 2xl:text-5xl" >
							MATIAS SALINAS
						</h1>
						<h2 class="text-lg text-[#FF8C00] sm:text-xl 2xl:text-2xl font-medium">
							Desarrollador Web
						</h2>
					</div>
					<p class="text-[#c2c2c2] font-medium text-[12px] lg:text-[14px] text-center lg:text-justify w-full overflow-y-auto">
						Soy desarrollador web y me gusta crear aplicaciones web
						que facilitan una tarea, logrando que esta pueda
						realizarse de manera mas sencilla y satisfactoria. Mi
						perfil se enfoca en el frontend con <b
							class="semiboldText">React</b
						>
						y tengo conocimientos de backend con <b
							class="semiboldText">NodeJS</b
						>.
						<br /><br />
						Lo que mas disfruto de la programación es el poder compartir
						con otros desarrolladores y el aprender para seguir mejorando
						y adquiriendo nuevas tecnologias.
					</p>

					{/* Buttons */}
					<div class="flex flex-wrap justify-center sm:justify-start gap-4 w-full lg:px-8" >
						{/* boton github */}
						<a
							href="https://github.com/Matisalinas23"
							target="_blank"
							class="buttonContact"
						>
							<div class="w-4 h-4">
								<GithubIcon />
							</div>
							GitHub
						</a>

						{/* boton linkedin */}
						<a
							href="https://www.linkedin.com/in/matias-salinas-045036374/"
							target="_blank"
							class="buttonContact"
						>
							<div class="w-4 h-4">
								<LinkedinIcon />
							</div>
							LinkedIn
						</a>

						{/* boton cv */}
						<a
							href="/CV_Matias_Salinas.pdf"
							download="CV_Matias_Salinas.pdf"
							class="bg-[#FF8C00] w-full max-w-[16rem] py-2 sm:w-40 md:w-48 h-[2.5rem] md:h-[2.8rem] xl:h-[3rem] xl:py-0 text-[0.7rem] md:text-[0.75rem] lg:text-[0.8rem] text-[#00050C] cursor-pointer font-semibold flex gap-2 items-center justify-center rounded-xl
							hover:bg-[#ffa538] hover:shadow-[0_0_10px_rgba(0,85,187,0.5)] transition-all duration-150"
						>
							<div class="w-5 h-5">
								<DownloadIcon />
							</div>
							Descargar CV
						</a>
					</div>
				</div>

				{/* picture */}
				<picture
					class="flex justify-center items-center p-[2px] w-36 h-36 sm:w-40 sm:h-40 lg:rounded-2xl lg:w-48 lg:h-48 rounded-full border-2 border-[#22344D]
					hover:border-[#8969ff] hover:shadow-[0_0_30px_rgba(0,85,187,1)] transition-all duration-200"
				>
					<img
						src="/images/perfil.png"
						alt="Imagen Predeterminada"
						class="w-full h-full object-cover rounded-full lg:rounded-[0.8rem]"
					/>
				</picture>
			</section>

			<hr class="w-full border-t border-white/50 opacity-50 mt-28" />

			{/* Proyectos */}
			<section id="proyectos" class="pt-40 w-full">
				<h2 class="text-[#AEC6FF] text-center font-semibold text-2xl md:text-3xl mb-12" >
					Mis Proyectos
				</h2>

				<div class="flex flex-col gap-16">
					{
						projects.map((p, index) => {
							const isEven = index % 2 === 0;
							return (
								<ProjectCard project={p} isEven={isEven} />
							);
						})
					}
				</div>
			</section>

			<section id="stack" class="w-full pt-40">
				<h2 class="text-[#AEC6FF] text-center font-semibold text-2xl md:text-3xl mb-12">
					Stack Tecnológico
				</h2>
				<div class="flex flex-col gap-14">
					{/* Frontend */}
					<div class="flex flex-col gap-6">
						<h3 class="text-xl font-medium text-white/80 border-l-4 border-[#FF8C00] pl-4">
							Frontend
						</h3>
						<div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-9 gap-4">
							{
								frontTechnologies.map((t) => (
									<TechBadge tech={t} />
								))
							}
						</div>
					</div>

					{/* Backend */}
					<div class="flex flex-col gap-6">
						<h3
							class="text-xl font-medium text-white/80 border-l-4 border-[#FF8C00] pl-4"
						>
							Backend
						</h3>
						<div
							class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-9 gap-4"
						>
							{
								backTechnologies.map((t) => (
									<TechBadge tech={t} />
								))
							}
						</div>
					</div>

					{/* Herramientas */}
					<div class="flex flex-col gap-6">
						<h3
							class="text-xl font-medium text-white/80 border-l-4 border-[#FF8C00] pl-4"
						>
							Herramientas
						</h3>
						<div
							class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-9 gap-4"
						>
							{
								tools.map((t) => (
									<TechBadge tech={t} />
								))
							}
						</div>
					</div>
				</div>
			<section id="formacion" class="w-full pt-30 pb-20">
				<h2 class="text-[#AEC6FF] text-center font-semibold text-2xl md:text-3xl mb-12" >
					Formación
				</h2>
				<div class="flex flex-col items-center">
					<div
						class="bg-black/30 px-8 py-6 rounded-xl border-2 border-white/10 w-full max-w-2xl flex flex-col gap-2
						hover:border-[#AEC6FF]/66 hover:shadow-[0_0_12px_#AEC6FF]/20 transition-colors group"
					>
						<div class="flex items-center gap-3">
							<h3
								class="text-md md:text-lg font-semibold text-white group-hover:text-[#AEC6FF] transition-colors"
							>
								Universidad Tecnológica Nacional (UTN FRM)
							</h3>
							<div class="w-5.5 h-5.5 bg-white/80 p-0.5 group-hover:bg-white transition-all duration-250"> <UtnIcon /> </div>
						</div>
						<div
							class="text-[#c2c2c2] font-medium px-2 text-sm md:text-base flex items-center gap-2"
						>

							<div class="h-[10px] w-[10px] border-[#FF8C00] bg-[#FF8C00]/66 group-hover:bg-[#FF8C00] group-hover:shadow-[0_0_12px_#FF8C00]/66 transition-all duration-250"></div>
							<p class="text-[15px]">Tecnicatura Universitaria en Programación (2023 - 2025)</p>
						</div>
					</div>
				</div>
			</section>
		</div>
	</main>
</Layout>

<style>
	.semiboldText {
		font-weight: 600;
		color: white;
	}

	.buttonContact {
		height: 3rem;
		width: 11rem;
		border: 1px solid #22344d;
		border-radius: 0.75rem;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		font-size: 0.875rem;
		font-weight: 500;
		transition: all 0.2s;
		color: white;
		text-decoration: none;
	}

	.buttonContact:hover {
		background-color: rgba(255, 255, 255, 0.05);
		border-color: #cfcfcf;
		box-shadow: 0 0 10px rgba(255, 255, 255, 0.25);
	}

	/* Ajustes por Breakpoints */
	@media screen and (max-width: 1200px) {
		.buttonContact {
			height: 2.8rem;
			width: 9.5rem;
			font-size: 0.8rem;
		}
	}

	@media screen and (max-width: 768px) {
		.buttonContact {
			height: 2.5rem;
			width: 8.5rem;
			font-size: 0.7rem;
		}
	}
	
	@media screen and (max-width: 480px) {
		.buttonContact {
			width: 100%;
			max-width: 16rem;
		}
	}

	/* Efecto Magic Border / Glow Hover para Proyectos */
	.project-card {
		--mouse-x: 50%;
		--mouse-y: 50%;
		--glow-opacity: 0;
	}

	.project-card::before,
	.project-card::after {
		content: "";
		position: absolute;
		inset: -2px; /* Compensa el border-2 */
		border-radius: inherit;
		padding: 2px; /* Grosor del borde */
		-webkit-mask:
			linear-gradient(#fff 0 0) content-box,
			linear-gradient(#fff 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
		z-index: -1;
		pointer-events: none;
	}

	/* Ajuste para pantallas más grandes donde el borde es de 3px */
	@media (min-width: 768px) {
		.project-card::before,
		.project-card::after {
			inset: -3px;
			padding: 3px;
		}
	}

	/* Borde estático base */
	.project-card::before {
		background: #22344d;
	}

	/* Brillo interactivo superpuesto en el borde */
	.project-card::after {
		background: radial-gradient(
			circle 300px at var(--mouse-x) var(--mouse-y),
			#8969ff 0%,
			transparent 100%
		);
		opacity: var(--glow-opacity);
		transition: opacity 0.3s ease;
	}

	.project-card:hover {
		--glow-opacity: 1;
	}
</style>

<script>
	const setupGlowCards = () => {
		const cards = document.querySelectorAll(".project-card, .formation-card");
		cards.forEach((card) => {
			if (card instanceof HTMLElement) {
				card.addEventListener("mousemove", (e) => {
					const rect = card.getBoundingClientRect();
					const x = e.clientX - rect.left;
					const y = e.clientY - rect.top;
					card.style.setProperty("--mouse-x", `${x}px`);
					card.style.setProperty("--mouse-y", `${y}px`);
				});
			}
		});
	};

	document.addEventListener("astro:page-load", setupGlowCards);
	setupGlowCards();
</script>
